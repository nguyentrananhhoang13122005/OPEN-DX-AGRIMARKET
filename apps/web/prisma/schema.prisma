generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum ParcelStatus {
  SOWING
  TENDING
  HARVEST_APPROVED
  HARVESTED
  DRAFT
}

enum ActivityType {
  SOWING
  FERTILIZING
  SPRAYING
  IRRIGATION
  HARVEST
  OTHER
}

enum LotStatus {
  DRAFT
  READY
  QR_EXPORTED
}

enum NotificationType {
  ANNOUNCEMENT
  HARVEST_APPROVED
  DISEASE_REPORT
  JOURNAL_SUBMITTED
  JOURNAL_APPROVED
  MARKET_ALERT
  SYSTEM
  BROADCAST
}

enum PartnerType {
  BUYER
  MIDDLEMAN
  WAREHOUSE
}

enum ChatRole {
  USER
  ASSISTANT
}

enum UserRole {
  MANAGER
  OFFICER
  FARMER
}

enum DiseaseReportStatus {
  PENDING
  CONFIRMED
}

// ─── HTX Profile (singleton) ─────────────────────────────────────────────────

model HtxProfile {
  id              String   @id @default(cuid())
  name            String
  address         String
  contact_phone   String?
  contact_email   String?
  crop_types      String[]
  season_label    String?
  htx_code        String   @unique
  total_area_ha   Float    @default(0)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
}

// ─── Households ───────────────────────────────────────────────────────────────

model Household {
  id              String    @id @default(cuid())
  name            String
  phone           String    @unique
  address         String?
  keycloak_user_id String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  parcels         Parcel[]
  disease_reports DiseaseReport[]
  notifications   Notification[]  @relation("RecipientHousehold")
}

// ─── Farm Zone ────────────────────────────────────────────────────────────────

model Parcel {
  id               String       @id @default(cuid())
  parcel_code      String       @unique
  household_id     String
  household        Household    @relation(fields: [household_id], references: [id])
  crop_type        String
  area_ha          Float
  centroid_lat     Float?
  centroid_lng     Float?
  polygon_geojson  Json?
  status           ParcelStatus @default(DRAFT)
  estimated_yield_per_ha Float?
  harvest_approved_by    String?
  harvest_approved_at    DateTime?
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt

  crop_cycles      ParcelCropCycle[]
  journal_entries  JournalEntry[]
  lot_parcels      LotParcel[]
  disease_reports  DiseaseReport[]
  weather_cache    WeatherCache[]

  @@index([household_id])
}

model ParcelCropCycle {
  id          String   @id @default(cuid())
  parcel_id   String
  parcel      Parcel   @relation(fields: [parcel_id], references: [id])
  season      String?
  sowed_at    DateTime?
  harvested_at DateTime?
  created_at  DateTime @default(now())

  @@index([parcel_id])
}

// ─── Journal ──────────────────────────────────────────────────────────────────

model JournalEntry {
  id              String             @id @default(cuid())
  parcel_id       String
  parcel          Parcel             @relation(fields: [parcel_id], references: [id])
  entry_date      DateTime
  activity_type   ActivityType
  performed_by    String
  submitted_by_id String?
  submitted_role  UserRole
  status          String             @default("PENDING_APPROVAL")
  approved_by_id  String?
  approved_at     DateTime?
  notes           String?

  weather_condition    String?
  weather_temperature  Float?
  weather_precipitation Float?
  weather_humidity      Float?

  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt

  activities      JournalActivity[]

  @@index([parcel_id])
  @@index([status])
}

model JournalActivity {
  id               String       @id @default(cuid())
  journal_entry_id String
  journal_entry    JournalEntry @relation(fields: [journal_entry_id], references: [id], onDelete: Cascade)
  activity_detail  String
  product_name     String?
  dosage           String?
  withdrawal_days  Int?
  created_at       DateTime     @default(now())

  @@index([journal_entry_id])
}

// ─── Lots & QR ───────────────────────────────────────────────────────────────

model Lot {
  id               String    @id @default(cuid())
  lot_code         String    @unique
  commodity        String
  quality_grade    String?
  packaging_date   DateTime?
  total_weight_kg  Float?
  packaging_spec   String?
  status           LotStatus @default(DRAFT)
  qr_image_url     String?
  certificate_keys String[]  @default([])
  created_by_id    String?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  lot_parcels      LotParcel[]
}

model LotParcel {
  id        String @id @default(cuid())
  lot_id    String
  lot       Lot    @relation(fields: [lot_id], references: [id])
  parcel_id String
  parcel    Parcel @relation(fields: [parcel_id], references: [id])

  @@unique([lot_id, parcel_id])
  @@index([parcel_id])
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id              String           @id @default(cuid())
  type            NotificationType
  title           String
  body            String
  recipient_id    String?
  household_id    String?
  household       Household?       @relation("RecipientHousehold", fields: [household_id], references: [id])
  sender_id       String?
  is_read         Boolean          @default(false)
  deep_link_url   String?
  tts_text        String?
  created_at      DateTime         @default(now())

  @@index([recipient_id, is_read])
  @@index([household_id])
  @@index([created_at])
}

// ─── Disease Detection ────────────────────────────────────────────────────────

model DiseaseReport {
  id                  String              @id @default(cuid())
  parcel_id           String
  parcel              Parcel              @relation(fields: [parcel_id], references: [id])
  household_id        String
  household           Household           @relation(fields: [household_id], references: [id])
  detected_by_id      String
  detection_date      DateTime
  photo_url           String
  photo_minio_key     String
  gps_lat             Float?
  gps_lng             Float?
  ai_disease_name     String
  ai_confidence       Float
  confirmed_diagnosis String?
  confirmed_by_id     String?
  confirmed_at        DateTime?
  treatment_notes     String?
  status              DiseaseReportStatus @default(PENDING)
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt

  @@index([parcel_id])
  @@index([household_id])
}

// ─── Market & Economic Data (n8n writes, Next.js reads) ──────────────────────

model MarketData {
  id          String   @id @default(cuid())
  source      String
  commodity   String
  metric      String
  value       Float
  unit        String
  period      String
  fetched_at  DateTime @default(now())

  @@unique([source, commodity, metric, period])
  @@index([commodity, fetched_at])
}

model Bulletin {
  id           String   @id @default(cuid())
  commodity    String
  bulletin_vi  String   @db.Text
  sources_json Json
  model_used   String
  is_latest    Boolean  @default(false)
  created_at   DateTime @default(now())

  @@index([commodity, is_latest])
}

model FxRate {
  id            String   @id @default(cuid())
  currency_pair String
  rate          Float
  fetched_at    DateTime @default(now())

  @@unique([currency_pair])
  @@index([currency_pair, fetched_at])
}

model WeatherCache {
  id              String   @id @default(cuid())
  parcel_id       String
  parcel          Parcel   @relation(fields: [parcel_id], references: [id])
  recorded_at     DateTime
  condition       String
  temperature_c   Float
  precipitation_mm Float
  humidity_pct    Float
  source          String   @default("open-meteo")

  @@unique([parcel_id, recorded_at])
}

// ─── Partner Map ──────────────────────────────────────────────────────────────

model Partner {
  id              String      @id @default(cuid())
  name            String
  partner_type    PartnerType
  contact_phone   String?
  primary_commodities String[]
  lat             Float
  lng             Float
  address         String?
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
}

// ─── Chat History ─────────────────────────────────────────────────────────────

model ChatHistory {
  id           String   @id @default(cuid())
  session_id   String
  user_id      String
  role         ChatRole
  content      String   @db.Text
  sources_json Json?
  chat_type    String
  created_at   DateTime @default(now())

  @@index([session_id, created_at])
  @@index([user_id, created_at])
}
