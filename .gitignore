# ============================================================
# DX-AgriMarket — .gitignore
# ============================================================

# ── Environment & Secrets ────────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.staging
.env.production

# ── Node / npm ───────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js

# ── Next.js ──────────────────────────────────────────────────
.next/
out/
build/

# ── TypeScript ───────────────────────────────────────────────
*.tsbuildinfo
tsconfig.tsbuildinfo

# ── Test & Coverage ──────────────────────────────────────────
coverage/
.nyc_output/
playwright-report/
test-results/

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
apps/disease-api/.venv/
apps/disease-api/__pycache__/
*.egg-info/
dist/
*.egg

# ── AI Models (binary, large files) ─────────────────────────
ai-models/
!ai-models/.gitkeep

# ── Docker ───────────────────────────────────────────────────
.docker/
docker-compose.override.yml

# ── OS generated ─────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── IDE / Editor ─────────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
.vscode/settings.json
*.swp
*.swo
*~
.project
.classpath
.settings/

# ── AI Agent tooling ─────────────────────────────────────────
.commandcode/
.gemini/
.agent/
playwright/.auth/
apps/web/playwright/.auth/
