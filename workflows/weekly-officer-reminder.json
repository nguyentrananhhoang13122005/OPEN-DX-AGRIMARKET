{
  "name": "Weekly Officer Reminder",
  "note": "Story 5.8: Weekly Officer Reminder (Friday 16:00). Queries pending journals and disease reports, inserts Web Bell notification, and pushes to Mattermost.",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 16 * * 5"
            }
          ]
        }
      },
      "id": "a1b2c3d4-0000-5aaa-bbbb-000000000001",
      "name": "Friday 16:00 Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT (SELECT count(*) FROM journal_entries WHERE status = 'PENDING_APPROVAL') as journal_count, (SELECT count(*) FROM disease_reports WHERE status = 'PENDING') as disease_count;"
      },
      "id": "a1b2c3d4-0000-5aaa-bbbb-000000000002",
      "name": "Query Pending Counts",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [250, 0],
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": ""
          },
          "conditions": [
            {
              "leftValue": "={{ Number($json.journal_count) + Number($json.disease_count) }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "larger"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "a1b2c3d4-0000-5aaa-bbbb-000000000003",
      "name": "Has Pending?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [500, 0]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO notifications (id, type, title, body, created_at, is_read, pushed_to_mattermost) VALUES (gen_random_uuid()::text, 'SYSTEM', 'Nhắc nhở duyệt cuối tuần', 'Hệ thống còn ' || '{{ $json.journal_count }}' || ' nhật ký và ' || '{{ $json.disease_count }}' || ' báo cáo sâu bệnh đang chờ duyệt.', NOW(), false, false);"
      },
      "id": "a1b2c3d4-0000-5aaa-bbbb-000000000004",
      "name": "Create Web Bell Notification",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [750, -100],
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst text = `🔔 **[DX-AgriMarket] Nhắc nhở cuối tuần**\\nHiện tại hệ thống còn **${data.journal_count}** nhật ký canh tác và **${data.disease_count}** báo cáo sâu bệnh đang chờ duyệt. Vui lòng kiểm tra và phê duyệt trước cuối tuần.`;\nreturn { json: { text } };"
      },
      "id": "a1b2c3d4-0000-5aaa-bbbb-000000000005",
      "name": "Format Mattermost Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1000, -100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MATTERMOST_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.text }) }}",
        "options": {}
      },
      "id": "a1b2c3d4-0000-5aaa-bbbb-000000000006",
      "name": "POST to Mattermost",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1250, -100],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Mattermost Webhook"
        }
      }
    },
    {
      "parameters": {},
      "id": "a1b2c3d4-0000-5aaa-bbbb-000000000007",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [0, -300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO notifications (id, type, title, body, created_at, is_read) VALUES (gen_random_uuid()::text, 'SYSTEM', 'n8n Workflow Error', 'Workflow ' || '{{$workflow.name}}' || ' failed (Execution ID: ' || '{{$json.execution.id}}' || ')', NOW(), false);"
      },
      "id": "a1b2c3d4-0000-5aaa-bbbb-000000000008",
      "name": "Log Error to Postgres",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [250, -300],
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Postgres account"
        }
      }
    }
  ],
  "connections": {
    "Friday 16:00 Trigger": {
      "main": [
        [
          {
            "node": "Query Pending Counts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Query Pending Counts": {
      "main": [
        [
          {
            "node": "Has Pending?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Pending?": {
      "main": [
        [
          {
            "node": "Create Web Bell Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Web Bell Notification": {
      "main": [
        [
          {
            "node": "Format Mattermost Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Mattermost Message": {
      "main": [
        [
          {
            "node": "POST to Mattermost",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Log Error to Postgres",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
