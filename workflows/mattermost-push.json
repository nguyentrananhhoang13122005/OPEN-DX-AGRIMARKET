{
  "id": "mattermost-push-wf",
  "name": "Mattermost Push Notifications",
  "note": "Story 5.7: Push high-priority notifications to Mattermost channel (cron mỗi 1 phút). Webhook URL from n8n credentials — KHÔNG hardcode.",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "a1b2c3d4-1111-4aaa-bbbb-000000000001",
      "name": "Cron Every 1 Minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, type, title, body, deep_link_url, created_at FROM notifications WHERE pushed_to_mattermost = false AND type IN ('MARKET_ALERT', 'DISEASE_REPORT', 'HARVEST_APPROVED') ORDER BY created_at ASC LIMIT 20;"
      },
      "id": "a1b2c3d4-2222-4aaa-bbbb-000000000002",
      "name": "Poll Unpushed Notifications",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        250,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": ""
          },
          "conditions": [
            {
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "a1b2c3d4-3333-4aaa-bbbb-000000000003",
      "name": "Has Notifications?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        500,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Format message for Mattermost\n// Format: [DX-AgriMarket] [title]\\n[body]\\nXem chi tiết: [deep_link_url]\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const data = item.json;\n  const typeEmoji = {\n    'MARKET_ALERT': '📊',\n    'DISEASE_REPORT': '🌿',\n    'HARVEST_APPROVED': '✅'\n  };\n  const emoji = typeEmoji[data.type] || '🔔';\n  let text = `${emoji} **[DX-AgriMarket] ${data.title}**\\n${data.body}`;\n  if (data.deep_link_url) {\n    text += `\\nXem chi tiết: ${data.deep_link_url}`;\n  }\n  results.push({ json: { id: data.id, text } });\n}\n\nreturn results;"
      },
      "id": "a1b2c3d4-4444-4aaa-bbbb-000000000004",
      "name": "Format Mattermost Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        750,
        -100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MATTERMOST_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.text }) }}",
        "options": {}
      },
      "id": "a1b2c3d4-5555-4aaa-bbbb-000000000005",
      "name": "POST to Mattermost Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1000,
        -100
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Mattermost Webhook"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE notifications SET pushed_to_mattermost = true WHERE id = '{{ $('Format Mattermost Message').item.json.id }}';"
      },
      "id": "a1b2c3d4-6666-4aaa-bbbb-000000000006",
      "name": "Mark as Pushed",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        1250,
        -100
      ],
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {},
      "id": "a1b2c3d4-7777-4aaa-bbbb-000000000007",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        -300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO notifications (id, type, title, body, created_at, is_read) VALUES (gen_random_uuid()::text, 'SYSTEM', 'n8n Workflow Error', 'Workflow ' || '{{$workflow.name}}' || ' failed (Execution ID: ' || '{{$json.execution.id}}' || ')', NOW(), false);"
      },
      "id": "a1b2c3d4-8888-4aaa-bbbb-000000000008",
      "name": "Log Error to Postgres",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        250,
        -300
      ],
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Postgres account"
        }
      }
    }
  ],
  "connections": {
    "Cron Every 1 Minute": {
      "main": [
        [
          {
            "node": "Poll Unpushed Notifications",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Poll Unpushed Notifications": {
      "main": [
        [
          {
            "node": "Has Notifications?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Notifications?": {
      "main": [
        [
          {
            "node": "Format Mattermost Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Mattermost Message": {
      "main": [
        [
          {
            "node": "POST to Mattermost Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "POST to Mattermost Webhook": {
      "main": [
        [
          {
            "node": "Mark as Pushed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Log Error to Postgres",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}