# docker/.env.local.example
DATABASE_URL=postgresql://agrimarket:your_password_here@postgres:5432/agrimarket
KEYCLOAK_DB_PASSWORD=keycloak
POSTGRES_USER=agrimarket
POSTGRES_PASSWORD=your_password_here
# OLLAMA_MODEL: Model name for AI chatbot
# - Groq cloud (recommended): openai/gpt-oss-20b, llama-3.1-8b-instant
# - Ollama CPU-only fallback (<=500MB): qwen2:0.5b  <- use this if no GPU
# - Ollama with GPU: phi3:mini, llama3, mistral
OLLAMA_MODEL=openai/gpt-oss-20b
# OLLAMA_BASE_URL: URL of local Ollama service inside Docker network
# Default: http://ollama:11434 (docker) | http://localhost:11434 (local dev)
OLLAMA_BASE_URL=http://ollama:11434
GROQ_API_KEY=your_groq_api_key_here
AUTH_SECRET=your_nextauth_secret_here
KEYCLOAK_CLIENT_ID=agrimarket-web
KEYCLOAK_CLIENT_SECRET=your_keycloak_secret_here
KEYCLOAK_ISSUER=http://keycloak:8080/realms/agrimarket
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET_NAME=agrimarket-docs
DISEASE_API_URL=http://disease-api:8000
PIPER_URL=http://piper:5500
N8N_ENCRYPTION_KEY=your_n8n_encryption_key_here
WTO_API_KEY=your_wto_api_key_here
COMTRADE_API_KEY=your_comtrade_api_key_here
MATTERMOST_WEBHOOK_URL=your_mattermost_webhook_url_here
